{
  "expo": {
    "name": "reminds",
    "slug": "reminds",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reminds",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.reminds",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDisplayName": "Reminders+",
        "CFBundleLocalizations": [
          "de",
          "en",
          "es",
          "fr",
          "pt",
          "hi",
          "zh",
          "ja",
          "it",
          "sv",
          "da",
          "fi",
          "pl",
          "nl",
          "tr",
          "cs",
          "hu",
          "ro",
          "el",
          "id",
          "vi",
          "ko",
          "uk",
          "ru",
          "ar"
        ],
        "NSCalendarsUsageDescription": "Wir importieren Termine aus Apple Kalender in deine App.",
        "NSCalendarsFullAccessUsageDescription": "Wir importieren Termine aus Apple Kalender in deine App.",
        "NSRemindersUsageDescription": "Wir importieren Erinnerungen aus Apple Erinnerungen in deine App.",
        "NSRemindersFullAccessUsageDescription": "Wir importieren Erinnerungen aus Apple Erinnerungen in deine App.",
        "NSLocationWhenInUseUsageDescription": "Wir verwenden deinen Standort, um den aktuellen Ort für den Task vorzuschlagen.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Wir verwenden deinen Standort, um den aktuellen Ort für den Task vorzuschlagen.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "package": "com.anonymous.reminds"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-calendar",
        {
          "calendarPermission": "Wir importieren Termine aus Apple Kalender in deine App.",
          "remindersPermission": "Wir importieren Erinnerungen aus Apple Erinnerungen in deine App."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/with-custom-icon",
      "./plugins/with-android-app-name",
      "./plugins/with-ios-cloud-sync",
      "./plugins/with-ios-pods-settings",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-iap",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "buildReactNativeFromSource": false
          }
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.anonymous.reminds.widgets",
          "groupIdentifier": "group.com.anonymous.reminds",
          "widgets": [
            {
              "name": "StreakWidget",
              "displayName": "Streak",
              "description": "Deine Serie an erledigten Tagen auf einen Blick.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "widgets/streak-widget.tsx"
              }
            },
            {
              "name": "TasksWidget",
              "displayName": "Heute",
              "description": "Deine offenen Aufgaben für heute – direkt abhakbar.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "widgets/tasks-widget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
